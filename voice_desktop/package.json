{
  "name": "voice-desktop",
  "productName": "Voice AI",
  "version": "0.1.0",
  "description": "Standalone Voice AI desktop client",
  "author": "Voice AI",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json && vite build",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "typescript": "latest",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "build": {
    "appId": "com.voiceai.desktop",
    "productName": "Voice AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
