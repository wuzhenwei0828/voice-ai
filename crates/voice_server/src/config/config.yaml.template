# voice-server 配置
# 连接字段使用 OpenAI-compatible 命名：api_base / api_key
# 顶层 `provider` 是 asr/llm/tts 的连接级默认值（被 per-section 字段覆盖）

log:
  level: info
  file: ../../logs/voice-server.log          # 相对 src/config/config.yaml → crates/voice-server/logs/
  format: text                             # text | json

server:
  port: 8080
  worker_num: 3

# 连接级默认：所有 client 都走这个 api_base / api_key
# 单独 section 可以覆盖
provider:
  api_base: "https://api.siliconflow.cn/v1"
  api_key: "sk-*******"
  timeout_ms: 30000
  headers:
    X-Region: cn-beijing

# ASR：multipart/form-data 上传音频 → {"text": "..."}
asr:
  api_base: "http://127.0.0.1:8000/sensevoice/v1"
  model: "sensevoice"
  # language: "zh"              # 强制语种（auto / zh / en / yue / ja / ko / nospeech）
  # response_format: "json"     # json | text | verbose_json，缺省 = json
  # spk: true                    # 说话人分离（首请求 +1~3s 懒加载 cam++ 模型）
  # tags: true                   # 保留 SenseVoice 标签，缺省剥离

# LLM：流式 chat completion
llm:
  model: "Qwen/Qwen3-8B"
  # 连接字段缺省时继承 provider；api_key 会映射为 x-api-key 请求头
  # api_base: "https://llm.example.com/v1"
  # api_key: "sk-*******"
  # timeout_ms: 30000
  # headers:
  #   X-Tenant: tenant-a
  # OpenAI Chat Completions 可选生成参数；缺省时不发送，使用上游默认值
  max_completion_tokens: 512
  temperature: 0.7
  top_p: 0.8
  top_k: 20
  # reasoning_effort: "low"       # 仅配置兼容该字段的模型/provider
  # include_usage: true           # 请求 stream_options.include_usage 并记录 token usage

llm_strong:
  model: "Qwen/Qwen3-30B-A3B"
  max_completion_tokens: 1024
  temperature: 0.6
  top_p: 0.95
  top_k: 20

# TTS：文本 → 音频（vLLM-Omni OpenAI-compatible speech API）
tts:
  model: "Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice"
  voice: "vivian"
  response_format: "wav"
  stream: true
  sample_rate: 24000
  channels: 1
  # transport: "websocket"   # 使用 /v1/audio/speech/stream 长连接
  # max_connections: 4       # WebSocket TTS 连接池最大并发连接数
  # vLLM-Omni 扩展字段（均可省略，使用服务端默认）
  # speed: 1.0
  # task_type: "CustomVoice"  # CustomVoice | VoiceDesign | Base
  # language: "Auto"
  # instructions: ""
  # max_new_tokens: 2048
  # stream_format: "sse"      # sse | audio,ws模式时配置成audio则stream_audio=true
  # ref_audio: "https://..."  # Base voice cloning
  # ref_text: "..."
  # x_vector_only_mode: false

# Redis：横切关注点，agent / 未来的 cache / rate-limit 等共用
# 不配 url 就当未启用 Redis，agent 会自动 fallback 到 in_memory
# key 全局前缀 ("voice:") 写死在代码里（REDIS_KEY_PREFIX），不在此处配置
redis:
  # url: "redis://user:pass@127.0.0.1:6379/0"   # 认证信息内嵌在 URL 里
  default_ttl_secs: 3600           # 各 consumer 未单独指定 TTL 时用这个

# LLM Agent：短期记忆后端 + 滑动窗口容量
# 想跨实例共享对话上下文时：redis.url + agent.memory_backend=redis
# Redis key 命名空间 = `redis.key_prefix` + 代码里写死的 "memory:" → "voice:memory:"
agent:
  memory_backend: "in_memory"      # in_memory（单进程）| redis（跨实例）
  memory_window: 20                # 滑动窗口：保留最近 N 条对话记录
  # memory_ttl_secs: 3600          # None = 继承 redis.default_ttl_secs

# 实时流式 ASR（公共协议：fun-asr / qwen-audio-3.0 / paraformer；wspool 跨浏览器会话复用）
# 端点：/ws/live-asr/web/<connid>（走 webhttp 既有 WS 路由 + VoicePayload 协议）
# 环境变量等价覆盖：DASHSCOPE_API_KEY / VOICE_ASR_LIVE_{API_KEY,MODEL,WORKSPACE_ID,REGION,ENDPOINT}
asr_live:
  model: "fun-asr-realtime"               # 或 qwen-audio-3.0-asr-flash-streaming / paraformer-realtime-v2
  api_key: "sk-*******"                  # DashScope API key
  workspace_id: "llm-xxxxxx"             # 业务空间 ID（公共协议端点必需，除非给 endpoint）
  region: "cn-beijing"                   # cn-beijing | ap-southeast-1
  # endpoint: "wss://自定义域名/api-ws/v1/inference"   # 显式覆盖
